{
  "manifest_version": 3,
  "name": "Résumé YouTube (FR)",
  "version": "1.0.0",
  "description": "Résume en français la vidéo YouTube en cours à partir de sa transcription, via l'API Mistral.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://api.mistral.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Résumer cette vidéo YouTube",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
